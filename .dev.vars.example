# Secrets a deployment needs. The Deploy to Cloudflare button asks for every name in this file, so
# keep the values empty and never add development switches here. Deploying by hand instead:
# `npx wrangler secret put <NAME>`. Local development uses .dev.vars.local.example.
# `npm run cf-typegen` reads the names from both files.

# Password for the first administrator, `admin`. Only used for the first sign-in: change the
# password in the app afterwards, then delete this secret.
ADMIN_INITIAL_PASSWORD=
# Turnstile widget (Cloudflare dashboard → Turnstile). The site key is public, the secret key is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

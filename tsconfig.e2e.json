{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["e2e/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    // page.evaluate() callbacks run in the browser.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
